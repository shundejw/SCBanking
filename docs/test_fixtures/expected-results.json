    {
      "id": "invalid-mt700-missing-32b",
      "category": "input-validation",
      "lc_file": "lc/MT700_Invalid_Missing32B.mt700",
      "invoice_file": "invoices/invoice-compliant-digital.pdf",
      "pdf_type": "digital",
      "ocr_required": false,
      "target_difference": "MT700 is missing mandatory field 32B. Must fail before document comparison; no fabricated LC amount, no ordinary document discrepancy.",
      "expected": {
        "status": "error",
        "http_status": 422,
        "error": {
          "error": "UNPROCESSABLE_ENTITY",
          "message": "Invalid MT700 format: mandatory field 32B (Currency Code, Amount) is missing."
        }
      }
    },
    {
      "id": "unreadable-pdf",
      "category": "input-validation",
      "lc_file": "lc/SWIFT_MT700_Sample_Compliant.mt700",
      "invoice_file": "invoices/invoice-unreadable.pdf",
      "pdf_type": "corrupt",
      "ocr_required": false,
      "target_difference": "Invoice PDF is corrupt and cannot be loaded/rendered. Must fail gracefully with a structured error; must not be reported compliant or produce a fake discrepancy.",
      "expected": {
        "status": "error",
        "http_status": 422,
        "error": {
          "error": "UNPROCESSABLE_ENTITY",
          "message": "PDF could not be rendered for text extraction or OCR; the document may be corrupt, encrypted, or unsupported."
        }
      }
    },
    {
      "id": "ocr-insufficient",
      "category": "input-validation",
      "lc_file": "lc/SWIFT_MT700_Sample_Compliant.mt700",
      "invoice_file": "invoices/invoice-compliant-scanned.pdf",
      "pdf_type": "scanned",
      "ocr_required": true,
      "target_difference": "Image PDF whose OCR returns insufficient content (< threshold). Validated at the PdfTextExtractor unit-test layer with a mocked OCR service; no separate fixture file. Must not be reported compliant.",
      "expected": {
        "status": "error",
        "http_status": 422,
        "error": {
          "error": "UNPROCESSABLE_ENTITY",
          "message": "PDF text extraction and OCR fallback did not yield sufficient readable content."
        }
      }
    }
  ]
